# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eship
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=eShipSecretKeyForJWTTokenGenerationPleaseChangeInProduction
JWT_EXPIRATION=86400000

# UPS API Configuration
UPS_API_KEY=your_ups_api_key_here
UPS_API_SECRET=your_ups_api_secret_here
UPS_ACCOUNT_NUMBER=your_ups_account_number

# FedEx API Configuration
FEDEX_API_KEY=your_fedex_api_key_here
FEDEX_API_SECRET=your_fedex_api_secret_here
FEDEX_ACCOUNT_NUMBER=your_fedex_account_number

# DHL API Configuration
DHL_API_KEY=your_dhl_api_key_here
DHL_API_SECRET=your_dhl_api_secret_here
DHL_ACCOUNT_NUMBER=your_dhl_account_number
